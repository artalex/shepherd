<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17: connecting to an address in the home network needs the Nearby devices permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- File transfers go on in the background in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Notifications about agents. After the app leaves the screen, a foreground service with a wake lock watches
         them for a few minutes; then a periodic job checks, kept across reboots. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Not asked for, as Google Play restricts both: REQUEST_INSTALL_PACKAGES, so a downloaded APK is installed from
         the phone's downloads and not from the app, and REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, so the limits on
         background work are lifted in the app's page of the system settings and not in a dialog of the app's. -->

    <application
        android:name=".HerdrApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Herdr">
        <!-- The app's one activity, at the root of the app's own task: the launcher icon, the notifications and the
             shares come to it there (onNewIntent) instead of starting another one over it, and whatever the app has
             opened over it in its task goes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <!-- Compose handles configuration changes itself; without recreation the live terminal
                 (termlib view, its emulator and the herdr control stream) survives rotation intact. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The app in the share menu: text for an agent's prompt, files for the host. It has no window and hands the
             share to MainActivity in the app's own task; a task of its own, when a sharing app asks for one, stays
             out of the recent apps. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".files.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- No foreground service type fits watching agents over SSH; specialUse has no daily time limit. -->
        <service
            android:name=".notify.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="For a few minutes after the app leaves the screen, watches the user's coding agents on their own server over SSH and notifies when one asks a question or finishes." />
        </service>
        <service
            android:name=".notify.CheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
